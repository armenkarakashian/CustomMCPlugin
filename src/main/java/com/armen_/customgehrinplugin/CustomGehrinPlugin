    @EventHandler
    public void onAnimalBreed(EntityBreedEvent ebe){
        Entity animal = ebe.getMother();
        String animal_name = animal.getName().toUpperCase();
        if (animal_list.contains(animal_name)){
            List<Integer> temperature_interval = animal_list.getIntegerList(animal_name);
            double temp = getBlockTemperature(animal.getLocation().getBlock());
            if (temperature_interval.get(0) > temp || temperature_interval.get(1) < temp){
                ebe.setCancelled(true);
                return;
            }
        }
        Player player = ((Player) ebe.getBreeder());
        Breedable breedable = (Breedable) animal;

        if (skill_item_list.contains(animal_name)){
            String player_name = player.getName();
            int has_skill = hasSkill(animal_name, player_name);
            if (has_skill > 0){
                if (animal_name.equals("WOLF")){
                    player.getWorld().dropItemNaturally(animal.getLocation(), new ItemStack(Material.WOLF_SPAWN_EGG,1));
                    ((ExperienceOrb) player.getWorld().spawn(animal.getLocation(), ExperienceOrb.class)).setExperience(5);
                   // add_experience(player, 5);
                    ebe.setCancelled(true);
                }
                else if (animal_name.equals("CHICKEN")){
                    player.getWorld().dropItemNaturally(animal.getLocation(), new ItemStack(Material.EGG, 1));
                    ((ExperienceOrb) player.getWorld().spawn(animal.getLocation(), ExperienceOrb.class)).setExperience(1);
                    //add_experience(player, 1);
                    ebe.setCancelled(true);
                }
                else if (Math.random() > 0.05){
                    ebe.setCancelled(true);
                    if (Math.random() > 0.95){
                        ItemStack miscarriage = new ItemStack(Material.ROTTEN_FLESH);
                        ItemMeta miscarriage_meta = miscarriage.getItemMeta();
                        miscarriage_meta.setDisplayName("Dead Fetus");
                        List<String> miscarriage_lore = new ArrayList<String>();
                        miscarriage_lore.add("Miscarriaged "+animal_name+" fetus");
                        miscarriage_meta.setLore(miscarriage_lore);
                        miscarriage.setItemMeta(miscarriage_meta);
                        animal.getWorld().dropItemNaturally(animal.getLocation(), miscarriage);
                    }
                }
            }
            else{
                ebe.setCancelled(true);
            }
        }
    }

    @EventHandler
    public void onAnimalSpawn(CreatureSpawnEvent cse){
        if (cse.getSpawnReason().name().equals("SPAWNER_EGG") && cse.getEntityType().name().equalsIgnoreCase("WOLF")){
            Tameable wolf = (Tameable) cse.getEntity();
            wolf.setBaby();
            Player closest = null;
            double smallest_distance = 0;
            for(Player p : wolf.getWorld().getPlayers()){
                double distance = p.getLocation().distance(wolf.getLocation());;
                if (closest == null){
                    smallest_distance = distance;
                    closest = p;
                }
                else if (distance < smallest_distance){
                    smallest_distance = distance;
                    closest = p;
                }
            }
            wolf.setOwner(closest);
        }
    }

