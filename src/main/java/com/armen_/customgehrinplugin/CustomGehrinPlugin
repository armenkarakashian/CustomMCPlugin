    public File getPlayerDataFile(String player){
        File[] file_list = data_folder.listFiles(new FilenameFilter()
        {
            public boolean accept(File dir, String name)
            {
                return name.startsWith(player) && name.endsWith(".yml");
            }
        });
        if (file_list.length > 0){
            return file_list[0];
        }
        else{
            return null;
        }
    }

    public FileConfiguration getPlayerDataConfig(String player){
        return YamlConfiguration.loadConfiguration(getPlayerDataFile(player));
    }

    public FileConfiguration getPlayerDataConfig(File player_file){
        return YamlConfiguration.loadConfiguration(player_file);
    }

    public FileConfiguration getConfigurationREAL(){
