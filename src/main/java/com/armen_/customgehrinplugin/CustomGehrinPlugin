    public int getTotalDays(World world){
        return (int) ((world.getFullTime()/24000)+1);
    }

    public int getTotalYears(World world){
        return (getTotalDays(world)-1)/365;
    }

    public double getLatitude(Block block){
        return Math.round((block.getZ()+spawn_z)*4500 / (world_border_size))/100;
        //return (Math.round((-(((block.getZ() - (double) spawn_z) / world_border_size) * 180)*100))/100.0)*(0.9);
    }

    public String getDate(World world){
        int total_days_in_year = getTotalDays(world)%365;
        int month = 0;
        for (int i = 1; i <= 12; i++){
            int days_in_month;
            if (i == 2){
                days_in_month = 28;
            }
            else{
                days_in_month = 30+(i%2);
            }
            if (total_days_in_year <= days_in_month){
                month = i-1;
                break;
            }
            else{
                total_days_in_year -= days_in_month;
            }
        }
        int year = 1+getTotalYears(world);
        return ChatColor.GOLD+(ChatColor.BOLD+(total_days_in_year+" "+months[month]+" "+year));
    }

    public double getBlockTemperature(Block block) {
        if (block.getWorld().getEnvironment().name().equals("NETHER")) {
            return 200;
        }
        double full_time = block.getWorld().getFullTime();
        double light_level = 7.5;
        light_level+=block.getLightFromBlocks()/5.0;
        double altitude = block.getY();
        double latitude = getLatitude(block);
        double t = (full_time % 8760000) / 730000;
        double temp = (((20 + 64*Math.abs(Math.cos((latitude*(3.141526/180))))) - (altitude * 0.15) + ((-8 * t)*(Math.pow(1.37, t - 12) - 1)) + Math.pow(light_level, 1.05))) + config.getDouble("GlobalWarmingFactor");
        temp *= 100;
        temp = Math.round(temp);
        return temp/100;
    }

