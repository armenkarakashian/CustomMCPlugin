    public String addUnderscores(String str){
        String ret = "";
        for (int i = 0; i < str.length(); i++){
            char c = str.charAt(i);
            if (c == ' '){
                ret+="_";
            }
            else{
                ret+=c;
            }
        }
        return ret;
    }

