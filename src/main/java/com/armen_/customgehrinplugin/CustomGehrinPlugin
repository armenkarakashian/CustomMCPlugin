    @EventHandler
    public void onCropGrow(BlockGrowEvent bge){
        Block block = bge.getBlock();

        String name = block.getType().name().toUpperCase();
        if (name.equals("AIR")){
            Location l = block.getLocation();
            Bukkit.getScheduler().runTask(this, () -> {
                Block new_block = l.getBlock();
                String new_name = new_block.getType().name().toUpperCase();
                if (crop_list.contains(new_name)){
                    double temperature = getBlockTemperature(new_block);
                    List<Double> interval = crop_list.getDoubleList(new_block.getType().name());
                    if (temperature < interval.get(0)-0.5){
                        new_block.setType(Material.AIR);
                    }
                    else if (temperature > interval.get(1)+0.5){
                        new_block.setType(Material.AIR);
                    }
                }
            });
        }
        else{
            if (block.getLightFromSky() == 0){
                if (Math.random() < 0.8){
                    bge.setCancelled(true);
                    return;
                }
            }
            if (crop_list.contains(name)){
                double temperature = getBlockTemperature(block);
                List<Double> interval = crop_list.getDoubleList(block.getType().name());
                if (temperature < interval.get(0)-0.5){
                    bge.setCancelled(true);
                    if (temperature < 25 && Math.random() > 0.6){
                        block.setType(Material.ICE);
                    }
                }
                else if (temperature > interval.get(1)+0.5){
                    bge.setCancelled(true);
                    if (temperature > 89 && Math.random() > 0.6){
                        block.setType(Material.FIRE);
                    }
                }
            }
        }
    }

    @EventHandler
    public void onSmelt(FurnaceSmeltEvent fse){
        ItemStack result = fse.getResult();
        ItemStack input = fse.getSource();
        ItemMeta input_meta = input.getItemMeta();
        if (cookable_list.contains(input.getType().name())){
            if (input.getItemMeta() != null){
                if (input_meta.getDisplayName() != null){
                    String disp = addUnderscores(input_meta.getDisplayName());
                    if (customcooknames.contains(disp)){
                        String custom_name = customcooknames.getString(disp);
                        ItemMeta result_meta = result.getItemMeta();
                        result_meta.setDisplayName(custom_name);
                        result.setItemMeta(result_meta);
                        fse.setResult(result);
                    }
                    if (skill_item_list.contains("COOK_"+disp)){
                        return;
                    }
                }
                fse.setResult(new ItemStack(Material.AIR));
            }
        }
    }

